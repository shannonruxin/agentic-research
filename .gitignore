# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# specs and personal preferences modules
.specs

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local secrets and overrides (keep out of git)
.env.local
.env.*.local
# `.env` at repo root may be committed: use it for shared non-secrets (e.g. CLERK_JWT_ISSUER_DOMAIN).
# Put API keys in `.env.local` only.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# workspace files
/workspace
/workspace/chat-memory.json
/workspace/user-output.md
/workspace/domain-manuals/domain-manual.json